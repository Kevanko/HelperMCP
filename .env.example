OPERATOR_KEY=change-me-long-random-string
PUBLIC_URL=https://help.example.com
# Option A (what install.sh --domain does): COMPOSE_PROFILES=caddy + a Caddyfile, Caddy gets the certificate itself, RELAY_BIND=127.0.0.1
